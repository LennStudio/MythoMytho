{
  "name": "mythomytho",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "test:domain": "tsc -p tsconfig.domain.json && node build-domain/scripts/domain-smoke.js && node scripts/run-flow.cjs"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-router": "*",
    "expo-font": "*",
    "expo-keep-awake": "*",
    "expo-linking": "*",
    "expo-constants": "*",
    "expo-asset": "*",
    "expo-audio": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-web": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "@react-native-async-storage/async-storage": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "@types/react": "*"
  }
}
